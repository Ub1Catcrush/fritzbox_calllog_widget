<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!--
         NoActionBar-Variante ist Voraussetzung für setSupportActionBar() mit
         einer eigenen MaterialToolbar. DarkActionBar würde eine zweite ActionBar
         durch den Window-Decor erzeugen und einen IllegalStateException-Crash
         beim Activity-Start auslösen (targetSdk 35+).
    -->
    <style name="Theme.FritzBoxCallWidget" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/purple_500</item>
        <item name="colorPrimaryVariant">@color/purple_700</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/teal_200</item>
        <item name="colorSecondaryVariant">@color/teal_700</item>
        <item name="colorOnSecondary">@color/black</item>
        <item name="android:statusBarColor" tools:targetApi="l">?attr/colorPrimaryVariant</item>
    </style>
</resources>
