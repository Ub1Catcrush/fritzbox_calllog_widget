<?xml version="1.0" encoding="utf-8"?>
<!--
     Ab Android 15 (SDK 35) ist Edge-to-Edge für alle Apps Pflicht:
     Das Fenster zeichnet hinter Statusleiste und Navigationsleiste.
     Ohne explizites Inset-Handling beginnt der PreferenceFragment-
     RecyclerView bei y=0 und die ersten Items verschwinden hinter der
     ActionBar.

     Lösung: CoordinatorLayout + AppBarLayout übernehmen das Inset-
     Management. Der settings_container bekommt layout_behavior, sodass
     er immer unterhalb der AppBarLayout-Höhe beginnt und der
     RecyclerView nie hinter der Toolbar liegt.
-->
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/app_bar_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fitsSystemWindows="true">

        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/toolbar"
            android:layout_width="match_parent"
            android:layout_height="?attr/actionBarSize"
            app:layout_scrollFlags="scroll|enterAlways" />

    </com.google.android.material.appbar.AppBarLayout>

    <FrameLayout
        android:id="@+id/settings_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_behavior="@string/appbar_scrolling_view_behavior" />

</androidx.coordinatorlayout.widget.CoordinatorLayout>
