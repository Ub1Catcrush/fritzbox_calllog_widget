<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!-- API 31-32: requires user grant via system settings -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <!-- API 33+: auto-granted, no user interaction needed -->
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <uses-feature
        android:name="android.hardware.telephony"
        android:required="false" />

    <application
        android:allowBackup="true"
        android:label="@string/app_name"
        android:icon="@mipmap/ic_fritzcalllog"
        android:roundIcon="@mipmap/ic_fritzcalllog_round"
        android:supportsRtl="true"
        android:name="com.tvcs.fritzboxcallwidget.FritzCallApplication"
        android:theme="@style/Theme.FritzBoxCallWidget"
        android:usesCleartextTraffic="true">


        <!-- Invisible trampoline so widget row taps can use an explicit,
             FLAG_MUTABLE PendingIntent on Android 14+ -->
        <activity
            android:name="com.tvcs.fritzboxcallwidget.widget.DialActivity"
            android:exported="false"
            android:theme="@android:style/Theme.NoDisplay" />


        <!-- Connection profile list with connectivity check -->
        <activity
            android:name=".prefs.ConnectionProfilesActivity"
            android:exported="false"
            android:label="@string/pref_connections_title"
            android:parentActivityName=".prefs.SettingsActivity" />
        <!-- Settings Activity -->
        <activity
            android:name=".prefs.SettingsActivity"
            android:exported="true"
            android:label="@string/settings_title">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Widget Config Activity -->
        <activity
            android:name="com.tvcs.fritzboxcallwidget.widget.WidgetConfigActivity"
            android:exported="true"
            android:label="@string/widget_configure">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_CONFIGURE" />
            </intent-filter>
        </activity>

        <!-- App Widget Provider -->
        <receiver
            android:name="com.tvcs.fritzboxcallwidget.widget.CallLogWidget"
            android:exported="true"
            android:label="@string/widget_name">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
                <action android:name="com.tvcs.fritzboxcallwidget.ACTION_REFRESH" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/call_log_widget_info" />
        </receiver>

        <!-- Widget Update Service -->
        <service
            android:name="com.tvcs.fritzboxcallwidget.widget.WidgetUpdateService"
            android:exported="false" />

        <!-- RemoteViews list service for widget ListView -->
        <service
            android:name="com.tvcs.fritzboxcallwidget.widget.CallLogRemoteViewsService"
            android:exported="false"
            android:permission="android.permission.BIND_REMOTEVIEWS" />

        <!-- Boot receiver to restart periodic updates -->
        <receiver
            android:name="com.tvcs.fritzboxcallwidget.widget.BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <!-- HTC/OnePlus quick-boot (soft reboot) -->
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

    
        <!-- Foreground service: keeps process alive for reliable SCREEN_ON reception.
             foregroundServiceType="specialUse" is required from targetSdk=34 when
             no other standard type fits. The use-case is: stay alive to receive
             ACTION_SCREEN_ON (not on the static-receiver exemption list) so the
             widget can refresh on screen-on without waiting for the next alarm.
             The android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE property is mandatory
             for Play Store submission when specialUse is declared. -->
        <service
            android:name="com.tvcs.fritzboxcallwidget.widget.WidgetForegroundService"
            android:exported="false"
            android:stopWithTask="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Listens for ACTION_SCREEN_ON to refresh the home-screen widget when the display turns on, ensuring up-to-date call-log data is visible without polling while the screen is off." />
        </service>

        <!--
             Static receiver for power events.
             ACTION_POWER_CONNECTED and ACTION_POWER_DISCONNECTED are on the
             Android 8+ implicit-broadcast exemption list and can be declared
             statically. exported="true" is required because these broadcasts
             are sent by the Android OS (not the app itself); exported="false"
             would silently prevent delivery on SDK 34+ and is flagged as an
             error when targetSdk=36.
             NOTE: BatteryManager.ACTION_CHARGING uses the namespace
             android.os.action (not android.intent.action).
        -->
        <receiver
            android:name="com.tvcs.fritzboxcallwidget.widget.PowerReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.ACTION_POWER_CONNECTED" />
                <action android:name="android.intent.action.ACTION_POWER_DISCONNECTED" />
                <!-- BatteryManager.ACTION_CHARGING (API 23+, minSdk=26 ✓) -->
                <action android:name="android.os.action.CHARGING" />
            </intent-filter>
        </receiver>

        <!-- WorkManager initialization provider (auto-initialised by WorkManager) -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup" />
        </provider>

        <!-- FileProvider für den APK-Download beim Update -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_provider_paths" />
        </provider>
    </application>
</manifest>
